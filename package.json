{
  "name": "code-review-workbench",
  "displayName": "Code Review Workbench",
  "description": "Personal-local code review workbench: committed PR diffs, Reviewed marks and anchored private drafts.",
  "version": "0.0.1",
  "publisher": "kaneki003",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaneki003/code-review-workbench.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "vscode": "^1.141.2"
  },
  "packageManager": "pnpm@12.11.2",
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Readiness requires a trusted local folder before running Git or the SQLite worker."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Open an already-cloned repository in a local desktop folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codeReviewWorkbench.checkReadiness",
        "title": "Code Review Workbench: Check Readiness"
      },
      {
        "command": "codeReviewWorkbench.openPrivateStore",
        "title": "Code Review Workbench: Open Private Store"
      },
      {
        "command": "codeReviewWorkbench.releasePrivateStore",
        "title": "Code Review Workbench: Release Private Store"
      },
      {
        "command": "codeReviewWorkbench.recoverPrivateStore",
        "title": "Code Review Workbench: Recover Private Store"
      },
      {
        "command": "codeReviewWorkbench.openPullRequestOverview",
        "title": "Code Review Workbench: Open Pull Request Overview"
      },
      {
        "command": "codeReviewWorkbench.inspectCommittedSource",
        "title": "Code Review Workbench: Inspect Committed PR Diffs",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeReviewWorkbench.reconcileCommittedSource",
        "title": "Code Review Workbench: Reconcile Committed Source"
      },
      {
        "command": "codeReviewWorkbench.openChangedDiff",
        "title": "Code Review Workbench: Open Committed Diff"
      },
      {
        "command": "codeReviewWorkbench.openCommittedFile",
        "title": "Code Review Workbench: Open Exact-Revision Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codeReviewWorkbench.returnToCommittedSource",
        "title": "Code Review Workbench: Return to Committed Source",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codeReviewWorkbench.markReviewed",
        "title": "Code Review Workbench: Mark File Reviewed",
        "icon": "$(check)"
      },
      {
        "command": "codeReviewWorkbench.unmarkReviewed",
        "title": "Code Review Workbench: Remove Reviewed Mark",
        "icon": "$(circle-slash)"
      },
      {
        "command": "codeReviewWorkbench.writeLocalDraft",
        "title": "Code Review Workbench: Write Private Local Draft",
        "icon": "$(comment)"
      },
      {
        "command": "codeReviewWorkbench.openLocalDraft",
        "title": "Code Review Workbench: Open Local Draft",
        "icon": "$(edit)"
      },
      {
        "command": "codeReviewWorkbench.showLocalDrafts",
        "title": "Code Review Workbench: Show Local Drafts",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codeReviewWorkbench.recreateDraftWriter",
        "title": "Code Review Workbench: Recreate Local Draft Writer",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeReviewWorkbench",
          "title": "Code Review Workbench",
          "icon": "media/review.svg"
        }
      ],
      "panel": [
        {
          "id": "codeReviewWorkbench-feedback",
          "title": "Private Feedback",
          "icon": "media/review.svg"
        }
      ]
    },
    "views": {
      "codeReviewWorkbench": [
        {
          "id": "codeReviewWorkbench.files",
          "name": "Changed Files",
          "icon": "media/review.svg"
        }
      ],
      "codeReviewWorkbench-feedback": [
        {
          "id": "codeReviewWorkbench.writer",
          "name": "Local Draft",
          "type": "webview",
          "icon": "media/review.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeReviewWorkbench.inspectCommittedSource",
          "when": "view == codeReviewWorkbench.files",
          "group": "navigation@1"
        },
        {
          "command": "codeReviewWorkbench.returnToCommittedSource",
          "when": "view == codeReviewWorkbench.files",
          "group": "navigation@2"
        },
        {
          "command": "codeReviewWorkbench.showLocalDrafts",
          "when": "view == codeReviewWorkbench.files || view == codeReviewWorkbench.writer",
          "group": "drafts@1"
        },
        {
          "command": "codeReviewWorkbench.recreateDraftWriter",
          "when": "view == codeReviewWorkbench.writer",
          "group": "drafts@2"
        }
      ],
      "view/item/context": [
        {
          "command": "codeReviewWorkbench.markReviewed",
          "when": "view == codeReviewWorkbench.files && viewItem == crw-unreviewed",
          "group": "inline"
        },
        {
          "command": "codeReviewWorkbench.unmarkReviewed",
          "when": "view == codeReviewWorkbench.files && viewItem == crw-reviewed",
          "group": "inline"
        },
        {
          "command": "codeReviewWorkbench.openCommittedFile",
          "when": "view == codeReviewWorkbench.files",
          "group": "navigation"
        },
        {
          "command": "codeReviewWorkbench.openChangedDiff",
          "when": "view == codeReviewWorkbench.files",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codeReviewWorkbench.writeLocalDraft",
          "when": "resourceScheme == crw-source",
          "group": "navigation@10"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codeReviewWorkbench.openLocalDraft",
          "when": "commentThread == crw-local-draft",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeReviewWorkbench.returnToCommittedSource",
        "key": "alt+shift+left",
        "when": "resourceScheme == crw-source"
      }
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm check && pnpm test",
    "dev": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "pnpm build:native && vitest run",
    "build:native": "node scripts/build-native.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:provider": "node scripts/test-provider.mjs",
    "build": "node scripts/build.mjs",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.2",
    "octokit": "5.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/markdown-it": "14.1.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mocha": "11.7.6",
    "node-gyp": "13.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
