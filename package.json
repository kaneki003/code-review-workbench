{
  "name": "code-review-workbench",
  "displayName": "Code Review Workbench",
  "description": "Personal-local code review workbench: read-only installed-host readiness.",
  "version": "0.0.1",
  "publisher": "kaneki003",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaneki003/code-review-workbench.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "vscode": "^1.141.2"
  },
  "packageManager": "pnpm@12.11.2",
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Readiness requires a trusted local folder before running Git or the SQLite worker."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Open an already-cloned repository in a local desktop folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codeReviewWorkbench.checkReadiness",
        "title": "Code Review Workbench: Check Readiness"
      }
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm check && pnpm test",
    "dev": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "pnpm build:native && vitest run",
    "build:native": "node scripts/build-native.mjs",
    "test:host": "node scripts/test-host.mjs",
    "build": "node scripts/build.mjs",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mocha": "11.7.6",
    "node-gyp": "13.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
